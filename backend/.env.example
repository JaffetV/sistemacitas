# Copia este archivo a .env. Usa contraseñas distintas y largas fuera de desarrollo.
POSTGRES_USER=marketplace_owner
POSTGRES_PASSWORD=change_this_postgres_owner_password
POSTGRES_DB=marketplace
APP_DB_PASSWORD=change_this_runtime_password
JWT_SECRET=replace_with_at_least_32_random_bytes_before_starting
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
